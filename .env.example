NODE_ENV=production
PORT=10000
BASE_PATH=/
# Wstaw połączenie z własną bazą. W razie potrzeby zachowaj parametry SSL dostawcy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Własne hasło; nigdy nie umieszczaj go w repozytorium.
ADMIN_PASSWORD=
RESEND_API_KEY=
# Adres w domenie zweryfikowanej w Resend.
RESEND_FROM_EMAIL="B-CORE <kontakt@twoja-domena.pl>"
